# check=skip=InvalidDefaultArgInFrom;error=true

# BrescaOS system image.
#
# Build speed: every dnf step mounts dnf's cache (/var/cache/libdnf5) from the
# container engine's build cache, with keepcache=True.

# Fedora major version.
# TODO: Should pin by digest?
# Required, no default: scripts/image.sh passes it from
# scripts/settings/settings.sh. Without it the FROM line fails (empty tag).
ARG FEDORA_VERSION

FROM quay.io/fedora/fedora:${FEDORA_VERSION} AS build-base
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True \
        gettext jq cmake extra-cmake-modules gcc-c++ qt6-qtbase-devel qt6-qtdeclarative-devel \
        kf6-kcmutils-devel kf6-kcolorscheme-devel kf6-kconfig-devel kf6-kcoreaddons-devel \
        kf6-ki18n-devel kf6-kjobwidgets-devel kf6-krunner-devel kf6-kwidgetsaddons-devel \
        libplasma-devel kdecoration-devel

# The translations of src/ (docs/translations.md), compiled with gettext:
# /out for the image, /metadata for the builds below.
FROM build-base AS translations
RUN --mount=type=bind,source=build/compile_translations.sh,target=/tmp/brescaos-build-compile_translations.sh \
    --mount=type=bind,source=src,target=/tmp/src \
    bash /tmp/brescaos-build-compile_translations.sh /tmp/src /out /metadata

# The builds below: one make job per CPU.

# BrescaOS Updates KCM.
FROM build-base AS updates-kcm-build
RUN --mount=type=bind,source=src/updates-kcm,target=/tmp/src \
    --mount=type=bind,from=translations,source=/metadata/updates-kcm,target=/tmp/metadata \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DTRANSLATED_METADATA_DIR=/tmp/metadata \
    && cmake --build /tmp/build --parallel "$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

# Autotiling: its KWin script, its KCM and the QML module the KCM and the tray
# applet share.
FROM build-base AS autotile-build
RUN --mount=type=bind,source=src/autotile,target=/tmp/src \
    --mount=type=bind,from=translations,source=/metadata/autotile,target=/tmp/metadata \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DTRANSLATED_METADATA_DIR=/tmp/metadata \
    && cmake --build /tmp/build --parallel "$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

# Bresca Welcome.
FROM build-base AS welcome-build
RUN --mount=type=bind,source=src/welcome,target=/tmp/src \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /tmp/build --parallel "$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

# The distroboxes' terminal colors (bresca-distrobox-colors), the tray
# applet's QML module and the KRunner plugin.
FROM build-base AS distrobox-build
RUN --mount=type=bind,source=src/distrobox,target=/tmp/src \
    --mount=type=bind,from=translations,source=/metadata/distrobox,target=/tmp/metadata \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DTRANSLATED_METADATA_DIR=/tmp/metadata \
    && cmake --build /tmp/build --parallel "$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

# KRunner plugin for BrescaOS.
FROM build-base AS bresca-krunner-build
RUN --mount=type=bind,source=src/bresca-krunner,target=/tmp/src \
    --mount=type=bind,from=translations,source=/metadata/bresca-krunner,target=/tmp/metadata \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DTRANSLATED_METADATA_DIR=/tmp/metadata \
    && cmake --build /tmp/build --parallel "$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

# Hexa's QML module, what its top bar knows about the wallpaper behind it,
# and its window decoration.
FROM build-base AS hexa-build
RUN --mount=type=bind,source=src/hexa,target=/tmp/src \
    --mount=type=bind,from=translations,source=/metadata/hexa,target=/tmp/metadata \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DTRANSLATED_METADATA_DIR=/tmp/metadata \
    && cmake --build /tmp/build --parallel "$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

# workbox's command line.
FROM build-base AS workbox-build
RUN --mount=type=bind,source=src/workbox,target=/tmp/src \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /tmp/build --parallel "$(nproc)" \
    && DESTDIR=/out cmake --install /tmp/build

# Everything the image copies as it is
FROM scratch AS files

# The bresca CLI (src/bresca-cli/README.md).
COPY --chmod=0755 src/bresca-cli/bresca /usr/bin/bresca
COPY --chmod=0755 src/bresca-cli/commands/ /usr/libexec/bresca/
COPY src/bresca-cli/completion.bash /usr/share/bash-completion/completions/bresca
COPY --chmod=0755 src/bresca-cli/services/updates/ /usr/libexec/bresca/services/updates/
COPY src/bresca-cli/lib/ /usr/libexec/bresca/lib/
COPY src/bresca-cli/services/bresca-updates@.service /usr/lib/systemd/system/
COPY src/bresca-cli/services/bresca-updates-check.timer /usr/lib/systemd/system/
COPY src/bresca-cli/services/bresca-updates.tmpfiles /usr/lib/tmpfiles.d/bresca-updates.conf
COPY src/bresca-cli/services/bresca-updates.rules /usr/share/polkit-1/rules.d/50-brescaos-updates.rules
# The tray icon and notification for a new version (src/updates-applet/README.md).
COPY src/updates-applet/package/ /usr/share/plasma/plasmoids/com.brescaos.updates/
# BrescaOS Updates KCM (src/updates-kcm/README.md).
COPY --from=updates-kcm-build /out/ /
# Autotiling (src/autotile/README.md): the KWin script, its KCM and the QML
# module, and the tray applet; both metadata.json come with the translations.
COPY --from=autotile-build /out/ /
COPY src/autotile/applet/package/ /usr/share/plasma/plasmoids/com.brescaos.autotile/
# Bresca Welcome (src/welcome/README.md); its .desktop files come with the
# translations.
COPY --from=welcome-build /out/ /
# Each distrobox's terminal colors and prompt, the Distrobox tray applet
# with its QML module and the KRunner plugin (src/distrobox/README.md); the
# applet's metadata.json and the plugin's .desktop file come with the
# translations.
COPY --from=distrobox-build /out/ /
COPY src/distrobox/distrobox.conf /usr/share/defaults/distrobox/distrobox.conf
COPY src/distrobox/profile.sh /usr/libexec/bresca/distrobox/profile.sh
COPY src/distrobox/applet/package/ /usr/share/plasma/plasmoids/com.brescaos.distrobox/
# The applet's symbol as a theme icon, for its metadata: About and the tray's
# settings show only an icon name, not a path.
COPY src/distrobox/applet/package/contents/icons/distrobox-symbolic.svg /usr/share/icons/hicolor/scalable/apps/com.brescaos.distrobox.svg
# KRunner plugin for BrescaOS (src/bresca-krunner/README.md).
COPY --from=bresca-krunner-build /out/ /
# Hexa, the desktop theme (src/hexa/README.md); its metadata.json come
# translated from the translations stage, its QML module and window
# decoration from hexa-build.
COPY --from=hexa-build /out/ /
COPY src/hexa/color-schemes/ /usr/share/color-schemes/
COPY src/hexa/look-and-feel/com.brescaos.hexa.light.desktop/contents/ /usr/share/plasma/look-and-feel/com.brescaos.hexa.light.desktop/contents/
COPY src/hexa/look-and-feel/com.brescaos.hexa.dark.desktop/contents/ /usr/share/plasma/look-and-feel/com.brescaos.hexa.dark.desktop/contents/
COPY src/hexa/look-and-feel/org.kde.plasma.desktop-layout.js /usr/share/plasma/look-and-feel/com.brescaos.hexa.light.desktop/contents/layouts/
COPY src/hexa/look-and-feel/org.kde.plasma.desktop-layout.js /usr/share/plasma/look-and-feel/com.brescaos.hexa.dark.desktop/contents/layouts/
COPY src/hexa/desktoptheme/hexa/dialogs/ /usr/share/plasma/desktoptheme/hexa/dialogs/
COPY src/hexa/desktoptheme/hexa/widgets/ /usr/share/plasma/desktoptheme/hexa/widgets/
COPY src/hexa/icons/hexa-light/ /usr/share/icons/hexa-light/
COPY src/hexa/icons/hexa-dark/ /usr/share/icons/hexa-dark/
COPY src/hexa/icons/actions/ /usr/share/icons/hexa-light/actions/
COPY src/hexa/icons/actions/ /usr/share/icons/hexa-dark/actions/
COPY src/hexa/icons/status/ /usr/share/icons/hexa-light/status/
COPY src/hexa/icons/status/ /usr/share/icons/hexa-dark/status/
COPY src/hexa/plasmoids/com.brescaos.hexa.topbar/contents/ /usr/share/plasma/plasmoids/com.brescaos.hexa.topbar/contents/
COPY src/hexa/plasmoids/com.brescaos.hexa.clock/contents/ /usr/share/plasma/plasmoids/com.brescaos.hexa.clock/contents/
COPY src/hexa/layout-templates/com.brescaos.hexa.topbar/contents/ /usr/share/plasma/layout-templates/com.brescaos.hexa.topbar/contents/
COPY src/hexa/style/ /usr/lib64/qt6/qml/com/brescaos/hexa/style/
# workbox, containers that share nothing with the host (src/workbox/README.md);
# its settings come from build/system.sh.
COPY --from=workbox-build /out/ /
COPY src/workbox/cli/completion.bash /usr/share/bash-completion/completions/workbox
# BrescaOS's desktop is Hexa: Hexa Light, with Hexa Dark as its dark pair.
# Plasma applies the Global Theme's defaults at login, unless the user chose
# another one.
COPY assets/desktop/kdeglobals /etc/xdg/kdeglobals
# KWin dims the windows without the focus, for every user unless they turn
# it off.
COPY assets/desktop/kwinrc /etc/xdg/kwinrc
# Qt Quick apps use Hexa's style, for every user (it only takes the place
# of KDE's desktop style where Hexa draws a control its own way).
COPY assets/desktop/hexa-qtquick-style.conf /usr/lib/environment.d/60-hexa-qtquick-style.conf
# Dolphin's defaults: system-wide in /etc/xdg (a user's own settings win),
# and the details view in a new user's home, copied once (Dolphin reads it
# only from there).
COPY assets/desktop/dolphinrc /etc/xdg/dolphinrc
COPY assets/desktop/dolphin-view-properties /etc/skel/.local/share/dolphin/view_properties/global/.directory
# KRunner's favorite plugins, BrescaOS's and Distrobox's results first, for
# every user unless they change them.
COPY assets/desktop/krunnerrc /etc/xdg/krunnerrc
# The BrescaOS logo (TRADEMARKS.md): os-release's LOGO names it, and the
# About This System page needs its path.
COPY assets/logo/brescaos-logo-light.svg assets/logo/brescaos-logo-dark.svg assets/logo/com.brescaos.welcome.svg assets/logo/com.brescaos.updates.svg /usr/share/icons/hicolor/scalable/apps/
COPY assets/logo/kcm-about-distrorc /etc/xdg/kcm-about-distrorc
# start-here is the distribution's logo, the launcher's icon in Fedora's
# Plasma themes (their dark panel); these replace generic-logos' placeholder.
COPY assets/logo/brescaos-logo-dark.svg /usr/share/icons/hicolor/scalable/apps/start-here.svg
COPY assets/logo/brescaos-logo-dark.svg /usr/share/icons/hicolor/scalable/places/start-here.svg

# The translations of src/.
COPY --from=translations /out/ /

COPY LICENSE /usr/share/licenses/brescaos/LICENSE
# The name's and the logo's terms, the logo's exception to the GPL.
COPY TRADEMARKS.md /usr/share/licenses/brescaos/TRADEMARKS.md

FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

ARG FEDORA_VERSION

# Fedora packages used by BrescaOS.
# podman: named so dnf doesn't pick docker for distrobox's "podman or docker".
# libglvnd-gles: KWin draws with OpenGL ES through libepoxy, which dlopens
# libGLESv2 (so no package requires it) and aborts without it.
# TODO: boot.automount: systemd-gpt-auto-generator stacks a boot.automount on top of
# ostree's /boot bind mount; ostree-finalize-staged's remount of /boot then
# fails with EINVAL and drops the staged update (bootc-dev/bootc#2402). The
# mask in /etc wins over the generated unit. Remove once Fedora ships ostree
# with ostreedev/ostree#3664.
# build/release.sh swaps Fedora's release packages for generic-* in this same
# step: every step that runs dnf writes rpm's whole database into its layer.
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    --mount=type=bind,source=build/release.sh,target=/tmp/brescaos-build-release.sh \
    dnf -y upgrade --refresh --setopt=install_weak_deps=False --setopt=keepcache=True \
    && dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True \
        bash-completion \
        jq \
        glibc-langpack-en glibc-langpack-es glibc-langpack-ca \
        plasma-desktop plasma-login-manager libglvnd-gles \
        konsole dolphin \
        plasma-breeze breeze-icon-theme \
        kscreen kscreenlocker \
        plasma-nm NetworkManager-wifi \
        pipewire pipewire-pulseaudio pipewire-alsa wireplumber plasma-pa \
        bluedevil \
        firewalld plasma-firewall plasma-firewall-firewalld \
        upower tuned-ppd \
        qt6-qttranslations qt6-qtimageformats \
        inotify-tools \
        plasma-milou \
        distrobox podman \
    && { [ "$(rpm -q kernel-core | wc -l)" -eq 1 ] \
        || dnf -y remove --oldinstallonly --limit=1 --setopt=keepcache=True; } \
    && set -- /usr/lib/modules/* \
    && { { [ "$#" -eq 1 ] && [ -f "$1/initramfs.img" ]; } \
        || { echo "error: expected one kernel with its initramfs.img, got: $*" >&2; exit 1; }; } \
    && bash /tmp/brescaos-build-release.sh \
    && systemctl mask boot.automount \
    && systemctl enable plasmalogin.service \
    && systemctl set-default graphical.target

# Version-independent system setup (build/system.sh). The build scripts are
# mounted, not copied: a COPY would be a layer of its own, and the script
# would stay in it.
RUN --mount=type=bind,source=build/system.sh,target=/tmp/brescaos-build-system.sh \
    bash /tmp/brescaos-build-system.sh "${FEDORA_VERSION}"

# BrescaOS's own files (the files stage).
COPY --from=files / /

# BrescaOS version of this build. Required, no default: scripts/image.sh
# passes VERSION.
ARG BRESCAOS_VERSION

LABEL org.opencontainers.image.title="BrescaOS" \
      org.opencontainers.image.description="BrescaOS, a versioned desktop OS based on Fedora" \
      org.opencontainers.image.version="${BRESCAOS_VERSION}" \
      containers.bootc="1"

# Version stamp (build/identity.sh). No dnf: a new VERSION builds without the
# network beyond the base image check. The files stage's timer is enabled in
# this step too, instead of in a layer of its own.
RUN --mount=type=bind,source=build/identity.sh,target=/tmp/brescaos-build-identity.sh \
    { [ -n "${BRESCAOS_VERSION}" ] || { echo "error: build argument BRESCAOS_VERSION is required" >&2; exit 1; }; } \
    && bash /tmp/brescaos-build-identity.sh "${BRESCAOS_VERSION}" "${FEDORA_VERSION}" \
    && systemctl enable bresca-updates-check.timer

RUN bootc container lint
