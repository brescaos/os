# check=skip=InvalidDefaultArgInFrom;error=true

# BrescaOS system image.
#
# Build speed: every dnf step mounts dnf's cache (/var/cache/libdnf5) from the
# container engine's build cache, with keepcache=True.

# Fedora major version.
# TODO: Should pin by digest?
# Required, no default: scripts/image.sh passes it from
# scripts/settings/settings.sh. Without it the FROM line fails (empty tag).
ARG FEDORA_VERSION

# The translations of src/ (docs/translations.md), compiled with gettext:
# /out for the image, /metadata for the builds below.
FROM quay.io/fedora/fedora:${FEDORA_VERSION} AS translations
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True gettext jq
COPY build/compile_translations.sh /tmp/brescaos-build-compile_translations.sh
RUN --mount=type=bind,source=src,target=/tmp/src \
    bash /tmp/brescaos-build-compile_translations.sh /tmp/src /out /metadata

# BrescaOS Updates KCM.
FROM quay.io/fedora/fedora:${FEDORA_VERSION} AS updates-kcm-build
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True \
        cmake extra-cmake-modules gcc-c++ kf6-kcmutils-devel
RUN --mount=type=bind,source=src/updates-kcm,target=/tmp/src \
    --mount=type=bind,from=translations,source=/metadata/updates-kcm,target=/tmp/metadata \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -DTRANSLATED_METADATA_DIR=/tmp/metadata \
    && cmake --build /tmp/build \
    && DESTDIR=/out cmake --install /tmp/build

# Bresca Welcome.
FROM quay.io/fedora/fedora:${FEDORA_VERSION} AS welcome-build
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True \
        cmake extra-cmake-modules gcc-c++ qt6-qtdeclarative-devel kf6-ki18n-devel kf6-kconfig-devel
RUN --mount=type=bind,source=src/welcome,target=/tmp/src \
    cmake -S /tmp/src -B /tmp/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /tmp/build \
    && DESTDIR=/out cmake --install /tmp/build

FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

ARG FEDORA_VERSION

# Fedora packages used by BrescaOS.
# libglvnd-gles: KWin draws with OpenGL ES through libepoxy, which dlopens
# libGLESv2 (so no package requires it) and aborts without it.
# TODO: boot.automount: systemd-gpt-auto-generator stacks a boot.automount on top of
# ostree's /boot bind mount; ostree-finalize-staged's remount of /boot then
# fails with EINVAL and drops the staged update (bootc-dev/bootc#2402). The
# mask in /etc wins over the generated unit. Remove once Fedora ships ostree
# with ostreedev/ostree#3664.
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y upgrade --refresh --setopt=install_weak_deps=False --setopt=keepcache=True \
    && dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True \
        bash-completion \
        jq \
        glibc-langpack-en glibc-langpack-es glibc-langpack-ca \
        plasma-desktop plasma-login-manager libglvnd-gles \
        konsole dolphin \
        plasma-breeze breeze-icon-theme \
        kscreen kscreenlocker \
        plasma-nm NetworkManager-wifi \
        pipewire pipewire-pulseaudio pipewire-alsa wireplumber plasma-pa \
        bluedevil \
        firewalld plasma-firewall plasma-firewall-firewalld \
        upower tuned-ppd \
        qt6-qttranslations qt6-qtimageformats \
        inotify-tools \
        plasma-milou \
    && { [ "$(rpm -q kernel-core | wc -l)" -eq 1 ] \
        || dnf -y remove --oldinstallonly --limit=1 --setopt=keepcache=True; } \
    && set -- /usr/lib/modules/* \
    && { { [ "$#" -eq 1 ] && [ -f "$1/initramfs.img" ]; } \
        || { echo "error: expected one kernel with its initramfs.img, got: $*" >&2; exit 1; }; } \
    && systemctl mask boot.automount \
    && systemctl enable plasmalogin.service \
    && systemctl set-default graphical.target

# Version-independent system setup
COPY build/system.sh /tmp/brescaos-build-system.sh
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    bash /tmp/brescaos-build-system.sh \
    && rm -f /tmp/brescaos-build-system.sh

# The bresca CLI (src/bresca-cli/README.md).
COPY --chmod=0755 src/bresca-cli/bresca /usr/bin/bresca
COPY --chmod=0755 src/bresca-cli/commands/ /usr/libexec/bresca/
COPY src/bresca-cli/completion.bash /usr/share/bash-completion/completions/bresca
COPY --chmod=0755 src/bresca-cli/services/updates/ /usr/libexec/bresca/services/updates/
COPY src/bresca-cli/lib/ /usr/libexec/bresca/lib/
COPY src/bresca-cli/services/bresca-updates@.service /usr/lib/systemd/system/
COPY src/bresca-cli/services/bresca-updates-check.timer /usr/lib/systemd/system/
COPY src/bresca-cli/services/bresca-updates.tmpfiles /usr/lib/tmpfiles.d/bresca-updates.conf
COPY src/bresca-cli/services/bresca-updates.rules /usr/share/polkit-1/rules.d/50-brescaos-updates.rules
# The tray icon and notification for a new version (src/updates-applet/README.md).
COPY src/updates-applet/package/ /usr/share/plasma/plasmoids/com.brescaos.updates/
# BrescaOS Updates KCM (src/updates-kcm/README.md).
COPY --from=updates-kcm-build /out/ /
# Bresca Welcome (src/welcome/README.md); its .desktop files come with the
# translations.
COPY --from=welcome-build /out/ /
RUN systemctl enable bresca-updates-check.timer

# The translations of src/.
COPY --from=translations /out/ /

COPY LICENSE /usr/share/licenses/brescaos/LICENSE

# BrescaOS version of this build. Required, no default: scripts/image.sh
# passes VERSION.
ARG BRESCAOS_VERSION

LABEL org.opencontainers.image.title="BrescaOS" \
      org.opencontainers.image.description="BrescaOS, a versioned desktop OS based on Fedora" \
      org.opencontainers.image.version="${BRESCAOS_VERSION}" \
      containers.bootc="1"

# Version stamp (build/identity.sh). No dnf: a new VERSION builds without the
# network beyond the base image check.
COPY build/identity.sh /tmp/brescaos-build-identity.sh
RUN { [ -n "${BRESCAOS_VERSION}" ] || { echo "error: build argument BRESCAOS_VERSION is required" >&2; exit 1; }; } \
    && bash /tmp/brescaos-build-identity.sh "${BRESCAOS_VERSION}" "${FEDORA_VERSION}" \
    && rm -f /tmp/brescaos-build-identity.sh

RUN bootc container lint
