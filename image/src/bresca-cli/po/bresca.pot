#: bresca
msgid ""
"Usage: bresca <command> [options]\n"
"\n"
"Commands:\n"
"  version     Print the running BrescaOS version\n"
"  updates     Manage BrescaOS updates\n"
"  help        Show this help\n"
"\n"
"Options:\n"
"  -h, --help  Show this help\n"
"\n"
"Run 'bresca <command> --help' for its options."
msgstr ""

#: bresca
msgid ""
"Usage: bresca updates <subcommand> [options]\n"
"\n"
"Subcommands:\n"
"  status      Current, staged and rollback versions (root)\n"
"  check       Check whether an update is available (root)\n"
"  download    Download the newer version without installing it (root)\n"
"  install     Install the downloaded version (root)\n"
"  rollback    Boot the previous version next time (root)\n"
"  registry    Where updates come from: image, registry, TLS (root)\n"
"  help        Show this help\n"
"\n"
"Options:\n"
"  -h, --help  Show this help\n"
"\n"
"Run 'bresca updates <subcommand> --help' for its options."
msgstr ""

#: commands/updates/check
msgid ""
"Usage: sudo bresca updates check [--format=json|text]\n"
"\n"
"Checks whether a newer BrescaOS version is available, without downloading\n"
"or changing anything.\n"
"\n"
"Options:\n"
"  --format=json  Print {checked_at, update_available, current_version,\n"
"                 available_version}, or {checked_at, error}\n"
"  -h, --help     Show this help"
msgstr ""

