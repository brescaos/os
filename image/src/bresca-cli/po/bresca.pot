#: commands/updates/download
msgid ""
"Usage: sudo bresca updates download [--no-tls] [--format=json|text]\n"
"\n"
"Downloads the newer BrescaOS version, if there is one, without installing "
"it.\n"
"Install it with 'sudo bresca updates install' before restarting: restarting\n"
"discards it (bootc keeps the downloaded data, so downloading it again is "
"fast).\n"
"\n"
"Options:\n"
"  --no-tls       Accept a registry allowed without TLS\n"
"  --format=json  Print {downloaded_at, download_only, update_available,\n"
"                 current_version, downloaded_version}, or {downloaded_at,\n"
"                 error}\n"
"  -h, --help     Show this help"
msgstr ""

#: commands/updates/download
msgid "the download didn't finish: see journalctl -u bresca-updates@download"
msgstr ""

#: commands/updates/download
#, sh-printf-format
msgid ""
"Downloaded BrescaOS %s. Install it with 'sudo bresca updates install' before "
"restarting: restarting discards it."
msgstr ""

#: commands/updates/download
#, sh-printf-format
msgid "BrescaOS is up to date (%s): nothing to download."
msgstr ""

#: commands/updates/download commands/updates/install
#, sh-printf-format
