#: commands/updates/rollback
msgid ""
"Usage: sudo bresca updates rollback [--discard-staged] [--reboot]\n"
"                                    [--format=json|text]\n"
"\n"
"Makes the previous BrescaOS version the one that boots next. Both stay on\n"
"disk, so running it again before the reboot goes back to the current one.\n"
"\n"
"Options:\n"
"  --discard-staged  Accept that a downloaded or installed version, not "
"booted\n"
"                    yet, is deleted\n"
"  --reboot          Restart after it, when the previous version boots next\n"
"  --format=json     Print {rolled_back_at, current_version, "
"rollback_queued,\n"
"                    boots_next_version}, or {rolled_back_at, error}\n"
"  -h, --help        Show this help"
msgstr ""

#: commands/updates/rollback
#, sh-printf-format
msgid ""
"BrescaOS %s is downloaded: rolling back deletes it. Run it again with --"
"discard-staged to accept it."
msgstr ""

#: commands/updates/rollback
#, sh-printf-format
msgid ""
"BrescaOS %s is installed: rolling back deletes it. Run it again with --"
"discard-staged to accept it."
msgstr ""

