// Lets an administrator (group wheel) start
// bresca-updates@check.service. Necessary for the tray applet's "Check
// for Updates" button (image/src/updates-applet/).
// ES5 only: polkit runs rules with Duktape.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "bresca-updates@check.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
