#!/usr/bin/env bash
# Runs as bresca-updates@install.service, and in download-install: installs
# the downloaded BrescaOS version, without the network, so the next boot uses
# it. The result goes to install.json.
set -euo pipefail

result_file=/run/bresca/updates/install.json
installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Atomically, so a reader never sees half a file.
write_file() {
    cat >"$1.tmp"
    mv "$1.tmp" "$1"
}

rm -f "$result_file"

# A downloaded version is staged but locked; --from-downloaded unlocks it.
if [[ $(bootc status --format=json | jq '.status.staged.downloadOnly == true') == true ]]; then
    if ! bootc_output=$(bootc upgrade --from-downloaded 2>&1); then
        printf '%s\n' "$bootc_output" >&2
        jq -cn --arg installed_at "$installed_at" --arg error "$bootc_output" \
            '{installed_at: $installed_at, error: $error}' | write_file "$result_file"
        exit 1
    fi
    printf '%s\n' "$bootc_output"
fi

# An unlocked staged version boots next: installed now or before.
bootc status --format=json | jq -c --arg installed_at "$installed_at" '
    .status.staged as $staged
    | {installed_at: $installed_at,
       current_version: (.status.booted.image.version // "unknown"),
       installed_version: (if $staged != null and $staged.downloadOnly != true
                           then $staged.image.version // "unknown" else null end)}' | write_file "$result_file"

# The version the last check announced is installed: its result is stale, and
# without it the tray icon goes. The next check (after the reboot) says what's
# newer.
if jq -e '.installed_version != null' "$result_file" >/dev/null; then
    rm -f /run/bresca/updates/check.json
fi
