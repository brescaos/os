#!/usr/bin/env bash
# bresca version: prints the running BrescaOS version.
set -euo pipefail
# shellcheck source=SCRIPTDIR/../lib/messages.sh
. /usr/libexec/bresca/lib/messages.sh

print_usage() {
    printf '%s\n' $"Usage: bresca version [--short] [--format=json|text]

Prints the running BrescaOS version.

Options:
  --short        Print only the version number
  --format=json  Print {version}
  -h, --help     Show this help"
}

format=text
for argument in "$@"; do
    case $argument in
        --short) format=short ;;
        --format=json) format=json ;;
        --format=text) format=text ;;
        -h | --help)
            print_usage
            exit 0
            ;;
        *)
            print_error $"unknown option: %s" "$argument"
            echo >&2
            print_usage >&2
            exit 2
            ;;
    esac
done

# shellcheck disable=SC1091 # os-release only exists on the target system
. /usr/lib/os-release
version=${IMAGE_VERSION:-unknown}

case $format in
    text)
        if [[ -t 1 ]]; then
            printf '\e[1m\e[38;5;111mBrescaOS %s\e[0m\n' "$version"
        else
            printf 'BrescaOS %s\n' "$version"
        fi
        ;;
    short) printf '%s\n' "$version" ;;
    json) jq -cn --arg version "$version" '{version: $version}' ;;
esac
