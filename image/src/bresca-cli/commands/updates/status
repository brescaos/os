#!/usr/bin/env bash
# bresca updates status: the current, staged and rollback versions, from
# bootc status.
set -euo pipefail
# shellcheck source=SCRIPTDIR/../../lib/messages.sh
. /usr/libexec/bresca/lib/messages.sh

print_usage() {
    printf '%s\n' $"Usage: sudo bresca updates status [--format=json|text]

Shows the current version, the staged one (downloaded, booted next unless it
was only downloaded) and the rollback one, and which boots next.

Options:
  --format=json  Print {current, staged, rollback, rollback_queued, boots_next}
  -h, --help     Show this help"
}

format=text
for argument in "$@"; do
    case $argument in
        --format=json) format=json ;;
        --format=text) format=text ;;
        -h | --help)
            print_usage
            exit 0
            ;;
        *)
            print_error $"unknown option: %s" "$argument"
            echo >&2
            print_usage >&2
            exit 2
            ;;
    esac
done

if ((EUID != 0)); then
    print_error $"'%s' needs root: run it with sudo" "bresca updates status"
    exit 1
fi

# shellcheck source=SCRIPTDIR/../../lib/registry-tls.sh
. /usr/libexec/bresca/lib/registry-tls.sh
warn_if_registry_without_tls

# A staged deployment that was only downloaded doesn't boot until installed.
status=$(bootc status --format=json | jq -c '
    def deployment(key):
        .status[key]
        | if . == null then null
          else {version: (.image.version // "unknown"), image: (.image.image.image // ""),
                download_only: (.downloadOnly // false)}
          end;
    {current: deployment("booted"), staged: deployment("staged"), rollback: deployment("rollback"),
     rollback_queued: (.status.rollbackQueued // false),
     boots_next: (if .status.rollbackQueued == true then "rollback"
                  elif .status.staged != null and .status.staged.downloadOnly != true then "staged"
                  else "current" end)}')

if [[ $format == json ]]; then
    printf '%s\n' "$status"
    exit 0
fi

if [[ -t 1 ]]; then
    bold=$'\e[1m' dim=$'\e[2m' accent=$'\e[38;5;111m' reset=$'\e[0m'
else
    bold='' dim='' accent='' reset=''
fi

printf '%sBrescaOS%s\n\n' "$bold$accent" "$reset"
jq -r '
    .boots_next as $next
    | ("current", "staged", "rollback") as $key
    | [$key,
       (.[$key] | if . == null then "—" else "\(.version)  \(.image)" end),
       (.[$key].download_only // false),
       ($key == $next)]
    | @tsv' <<<"$status" \
    | while IFS=$'\t' read -r key deployment is_download_only boots_next; do
        case $key in
            current) symbol=● label=$"Current" ;;
            staged) symbol=◐ label=$"Staged" ;;
            rollback) symbol=○ label=$"Rollback" ;;
        esac
        if [[ $is_download_only == true ]]; then
            printf -v deployment '%s  (%s)' "$deployment" $"downloaded, not installed"
        fi
        if [[ $boots_next == true ]]; then
            printf '  %s%s %-10s%s %s  %s%s%s\n' "$accent" "$symbol" "$label" "$reset" "$deployment" "$dim" $"← boots next" "$reset"
        else
            printf '  %s%s %-10s%s %s\n' "$dim" "$symbol" "$label" "$reset" "$deployment"
        fi
    done
printf '\n'
