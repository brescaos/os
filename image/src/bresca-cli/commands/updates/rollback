#!/usr/bin/env bash
# bresca updates rollback: makes the previous BrescaOS version the one that
# boots next, or, run again before the reboot, the current one again. It runs
# as bresca-updates@rollback; this starts it and prints its result.
set -euo pipefail
# shellcheck source=SCRIPTDIR/../../lib/messages.sh
. /usr/libexec/bresca/lib/messages.sh

print_usage() {
    printf '%s\n' $"Usage: sudo bresca updates rollback [--discard-staged] [--reboot]
                                    [--format=json|text]

Makes the previous BrescaOS version the one that boots next. Both stay on
disk, so running it again before the reboot goes back to the current one.

Options:
  --discard-staged  Accept that a downloaded or installed version, not booted
                    yet, is deleted
  --reboot          Restart after it, when the previous version boots next
  --format=json     Print {rolled_back_at, current_version, rollback_queued,
                    boots_next_version}, or {rolled_back_at, error}
  -h, --help        Show this help"
}

should_discard_staged=false
should_reboot=false
format=text
for argument in "$@"; do
    case $argument in
        --discard-staged) should_discard_staged=true ;;
        --reboot) should_reboot=true ;;
        --format=json) format=json ;;
        --format=text) format=text ;;
        -h | --help)
            print_usage
            exit 0
            ;;
        *)
            print_error $"unknown option: %s" "$argument"
            echo >&2
            print_usage >&2
            exit 2
            ;;
    esac
done

if ((EUID != 0)); then
    print_error $"'%s' needs root: run it with sudo" "bresca updates rollback"
    exit 1
fi

# shellcheck source=SCRIPTDIR/../../lib/registry.sh
. /usr/libexec/bresca/lib/registry.sh
warn_if_registry_without_tls

# bootc rollback deletes a staged version: only once the user accepts it.
# "<version> <downloaded|installed>", when there's one and something to roll
# back to.
staged=$(bootc status --format=json | jq -r '
    .status
    | if .staged != null and .rollback != null
      then "\(.staged.image.version // "unknown") \(if .staged.downloadOnly then "downloaded" else "installed" end)"
      else empty end')
if [[ -n $staged ]] && ! $should_discard_staged; then
    if [[ ${staged#* } == downloaded ]]; then
        print_error $"BrescaOS %s is downloaded: rolling back deletes it. Run it again with --discard-staged to accept it." "${staged% *}"
    else
        print_error $"BrescaOS %s is installed: rolling back deletes it. Run it again with --discard-staged to accept it." "${staged% *}"
    fi
    exit 1
fi

result_file=/run/bresca/updates/rollback.json

# If one is already running, this waits for it. Its failure message only
# points to systemctl status: the result has ours.
systemctl start bresca-updates@rollback.service 2>/dev/null || true

if [[ ! -f $result_file ]]; then
    print_error $"the rollback didn't finish: see journalctl -u bresca-updates@rollback"
    exit 1
fi
rollback_result=$(<"$result_file")
rollback_error=$(jq -r '.error // empty' <<<"$rollback_result")
is_rollback_queued=$(jq -r '.rollback_queued // false' <<<"$rollback_result")

if [[ $format == json ]]; then
    printf '%s\n' "$rollback_result"
elif [[ -n $rollback_error ]]; then
    print_error $"couldn't roll back: %s" "$rollback_error"
else
    boots_next_version=$(jq -r '.boots_next_version // empty' <<<"$rollback_result")
    if [[ $is_rollback_queued == true ]] && $should_reboot; then
        print_message $"BrescaOS %s boots next. Restarting..." "$boots_next_version"
    elif [[ $is_rollback_queued == true ]]; then
        print_message $"BrescaOS %s boots next. Restart to use it: sudo systemctl reboot" "$boots_next_version"
    elif [[ -z $boots_next_version ]]; then
        print_message $"Nothing to roll back to: there's no previous version."
    else
        print_message $"BrescaOS %s (the current one) boots next again." "$boots_next_version"
    fi
fi
[[ -z $rollback_error ]] || exit 1

if $should_reboot && [[ $is_rollback_queued == true ]]; then
    systemctl reboot
fi
