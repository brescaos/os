#!/usr/bin/env bash
# bresca updates registry: where updates come from, the image this system
# follows and whether its registry is allowed without TLS.
set -euo pipefail
# shellcheck source=SCRIPTDIR/../../lib/messages.sh
. /usr/libexec/bresca/lib/messages.sh

print_usage() {
    printf '%s\n' $"Usage: sudo bresca updates registry [--format=json|text]

Shows the image updates come from: its registry, repository and tag, and
whether the registry is allowed without TLS.

Options:
  --format=json  Print {image, registry, repository, tag, tls}
  -h, --help     Show this help"
}

format=text
for argument in "$@"; do
    case $argument in
        --format=json) format=json ;;
        --format=text) format=text ;;
        -h | --help)
            print_usage
            exit 0
            ;;
        *)
            print_error $"unknown option: %s" "$argument"
            echo >&2
            print_usage >&2
            exit 2
            ;;
    esac
done

if ((EUID != 0)); then
    print_error $"'%s' needs root: run it with sudo" "bresca updates registry"
    exit 1
fi

# shellcheck source=SCRIPTDIR/../../lib/registry-tls.sh
. /usr/libexec/bresca/lib/registry-tls.sh
warn_if_registry_without_tls

image=$(find_followed_image)
if [[ -z $image ]]; then
    print_error $"bootc status shows no image this system follows"
    exit 1
fi

# The tag is after the last ":" that follows the last "/", so a registry's
# port (10.0.2.2:5050) isn't taken for it. No tag means latest.
last_component=${image##*/}
if [[ $last_component == *:* ]]; then
    tag=${last_component##*:}
    image_name=${image%:*}
else
    tag=latest
    image_name=$image
fi
registry=''
repository=$image_name
if [[ $image_name == */* ]]; then
    registry=${image_name%%/*}
    repository=${image_name#*/}
fi
has_tls=true
if [[ -n $registry ]] && is_registry_allowed_without_tls "$registry"; then
    has_tls=false
fi

if [[ $format == json ]]; then
    jq -cn --arg image "$image" --arg registry "$registry" --arg repository "$repository" \
        --arg tag "$tag" --argjson tls "$has_tls" \
        '{image: $image, registry: (if $registry == "" then null else $registry end),
          repository: $repository, tag: $tag, tls: $tls}'
    exit 0
fi

if [[ -t 1 ]]; then
    bold=$'\e[1m' dim=$'\e[2m' accent=$'\e[38;5;111m' yellow=$'\e[33m' reset=$'\e[0m'
else
    bold='' dim='' accent='' yellow='' reset=''
fi

printf '%s%s%s\n\n' "$bold$accent" $"BrescaOS updates" "$reset"
printf '  %s%-11s%s %s\n' "$dim" $"Image" "$reset" "$image"
printf '  %s%-11s%s %s' "$dim" $"Registry" "$reset" "${registry:-—}"
$has_tls || printf '  %s(%s)%s' "$yellow" $"without TLS" "$reset"
printf '\n'
printf '  %s%-11s%s %s\n' "$dim" $"Repository" "$reset" "$repository"
printf '  %s%-11s%s %s\n\n' "$dim" $"Tag" "$reset" "$tag"
