#!/usr/bin/env bash
# bresca updates check: whether a newer BrescaOS version is available. The
# check runs as bresca-updates@check.service; this starts it and prints its
# result.
set -euo pipefail
# shellcheck source=SCRIPTDIR/../../lib/messages.sh
. /usr/libexec/bresca/lib/messages.sh

print_usage() {
    printf '%s\n' $"Usage: sudo bresca updates check [--format=json|text]

Checks whether a newer BrescaOS version is available, without downloading
or changing anything.

Options:
  --format=json  Print {checked_at, update_available, current_version,
                 available_version}, or {checked_at, error}
  -h, --help     Show this help"
}

format=text
for argument in "$@"; do
    case $argument in
        --format=json) format=json ;;
        --format=text) format=text ;;
        -h | --help)
            print_usage
            exit 0
            ;;
        *)
            print_error $"unknown option: %s" "$argument"
            echo >&2
            print_usage >&2
            exit 2
            ;;
    esac
done

if ((EUID != 0)); then
    print_error $"'%s' needs root: run it with sudo" "bresca updates check"
    exit 1
fi

# shellcheck source=SCRIPTDIR/../../lib/registry-tls.sh
. /usr/libexec/bresca/lib/registry-tls.sh
warn_if_registry_without_tls

result_file=/run/bresca/updates/check.json

[[ $format == json ]] || print_message $"Checking for updates..."
# If one is already running (e.g. started by System Settings), this waits for
# it. Its failure message only points to systemctl status: the result has ours.
systemctl start bresca-updates@check.service 2>/dev/null || true

if [[ ! -f $result_file ]]; then
    print_error $"the check didn't finish: see journalctl -u bresca-updates@check"
    exit 1
fi
check_result=$(<"$result_file")
check_error=$(jq -r '.error // empty' <<<"$check_result")

if [[ $format == json ]]; then
    printf '%s\n' "$check_result"
elif [[ -z $check_error ]]; then
    current_version=$(jq -r '.current_version' <<<"$check_result")
    if [[ $(jq -r '.update_available' <<<"$check_result") == true ]]; then
        print_message $"BrescaOS %s is available (running %s)." \
            "$(jq -r '.available_version' <<<"$check_result")" "$current_version"
    else
        print_message $"BrescaOS is up to date (%s)." "$current_version"
    fi
else
    print_error $"couldn't check for updates: %s" "$check_error"
fi
[[ -z $check_error ]] || exit 1
