#!/usr/bin/env bash
# bresca updates download: downloads the newer BrescaOS version, if there is
# one, without installing it. The download runs as
# bresca-updates@download.service; this starts it, shows its progress and
# prints its result.
set -euo pipefail
# shellcheck source=SCRIPTDIR/../../lib/messages.sh
. /usr/libexec/bresca/lib/messages.sh

print_usage() {
    printf '%s\n' $"Usage: sudo bresca updates download [--no-tls] [--format=json|text]

Downloads the newer BrescaOS version, if there is one, without installing it:
the next boot still uses the current version until it's installed.

Options:
  --no-tls       Accept a registry allowed without TLS
  --format=json  Print {downloaded_at, update_available, current_version,
                 downloaded_version}, or {downloaded_at, error}
  -h, --help     Show this help"
}

is_no_tls_accepted=false
format=text
for argument in "$@"; do
    case $argument in
        --no-tls) is_no_tls_accepted=true ;;
        --format=json) format=json ;;
        --format=text) format=text ;;
        -h | --help)
            print_usage
            exit 0
            ;;
        *)
            print_error $"unknown option: %s" "$argument"
            echo >&2
            print_usage >&2
            exit 2
            ;;
    esac
done

if ((EUID != 0)); then
    print_error $"'%s' needs root: run it with sudo" "bresca updates download"
    exit 1
fi

# shellcheck source=SCRIPTDIR/../../lib/registry.sh
. /usr/libexec/bresca/lib/registry.sh
stop_if_registry_without_tls "$is_no_tls_accepted"

result_file=/run/bresca/updates/download.json

if [[ $format == text ]]; then
    # shellcheck source=SCRIPTDIR/../../lib/download-progress.sh
    . /usr/libexec/bresca/lib/download-progress.sh
    start_operation_showing_download_progress download
else
    # If one is already running, this waits for it. Its failure message only
    # points to systemctl status: the result has ours.
    systemctl start bresca-updates@download.service 2>/dev/null || true
fi

if [[ ! -f $result_file ]]; then
    print_error $"the download didn't finish: see journalctl -u bresca-updates@download"
    exit 1
fi
download_result=$(<"$result_file")
download_error=$(jq -r '.error // empty' <<<"$download_result")

if [[ $format == json ]]; then
    printf '%s\n' "$download_result"
elif [[ -z $download_error ]]; then
    current_version=$(jq -r '.current_version' <<<"$download_result")
    if [[ $(jq -r '.update_available' <<<"$download_result") == true ]]; then
        print_message $"Downloaded BrescaOS %s. The next boot still uses %s until it's installed." \
            "$(jq -r '.downloaded_version' <<<"$download_result")" "$current_version"
    else
        print_message $"BrescaOS is up to date (%s): nothing to download." "$current_version"
    fi
else
    print_error $"couldn't download the update: %s" "$download_error"
fi
[[ -z $download_error ]] || exit 1
