# check=skip=InvalidDefaultArgInFrom;error=true

# Tests of the bresca CLI (scripts/test.sh, make test): bats, run in the
# BrescaOS image, so the CLI is where image/Containerfile installs it. bootc
# and systemctl are fakes (fakes/), ahead of the real ones in PATH.

# The BrescaOS image to test. Required, no default: scripts/test.sh passes it.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True bats

COPY --chmod=0755 fakes/ /usr/lib/bresca-tests/fakes/
COPY helpers.bash *.bats /usr/lib/bresca-tests/
ENV PATH=/usr/lib/bresca-tests/fakes:$PATH

CMD ["bats", "--print-output-on-failure", "/usr/lib/bresca-tests"]
