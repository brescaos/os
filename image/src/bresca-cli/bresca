#!/usr/bin/env bash
# bresca: the BrescaOS system CLI. Each command is its own script in
# /usr/libexec/bresca/; this one only runs it.
set -euo pipefail
# shellcheck source=lib/messages.sh
. /usr/libexec/bresca/lib/messages.sh

print_usage() {
    printf '%s\n' $"Usage: bresca <command> [options]

Commands:
  version     Print the running BrescaOS version
  updates     Manage BrescaOS updates
  help        Show this help

Options:
  -h, --help  Show this help

Run 'bresca <command> --help' for its options."
}

print_updates_usage() {
    printf '%s\n' $"Usage: bresca updates <subcommand> [options]

Subcommands:
  status      Current, staged and rollback versions (root)
  check       Check whether an update is available (root)
  download    Download the newer version without installing it (root)
  install     Install the downloaded version (root)
  rollback    Boot the previous version next time (root)
  registry    Where updates come from: image, registry, TLS (root)
  help        Show this help

Options:
  -h, --help  Show this help

Run 'bresca updates <subcommand> --help' for its options."
}

case ${1:-help} in
    version)
        command=$1
        shift
        exec "/usr/libexec/bresca/$command" "$@"
        ;;
    updates)
        case ${2:-help} in
            status | check | download | install | rollback | registry) exec "/usr/libexec/bresca/updates/$2" "${@:3}" ;;
            help | -h | --help) print_updates_usage ;;
            *)
                print_updates_usage >&2
                exit 2
                ;;
        esac
        ;;
    help | -h | --help) print_usage ;;
    *)
        print_usage >&2
        exit 2
        ;;
esac
