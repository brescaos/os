# Breeze's defaults with Hexa Light's colors (color-schemes/HexaLight.colors):
# everything Hexa doesn't style yet is Breeze's.
[kdeglobals][General]
ColorScheme=HexaLight

[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][Icons]
