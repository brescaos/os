# Breeze's defaults with Hexa Dark's colors (color-schemes/HexaDark.colors):
# everything Hexa doesn't style yet is Breeze's.
[kdeglobals][General]
ColorScheme=HexaDark

# Hexa's QtWidgets style: Breeze's, without the line along scroll bars.
[kdeglobals][KDE]
widgetStyle=Hexa

[kdeglobals][Icons]
Theme=hexa-dark

[plasmarc][Theme]
name=hexa

# Hexa's window decoration: the app's icon on the left, and minimize,
# maximize and close on the right.
[kwinrc][org.kde.kdecoration2]
library=com.brescaos.hexa.decoration
ButtonsOnLeft=M
ButtonsOnRight=IAX

[kcminputrc][Mouse]
cursorTheme=breeze_cursors
