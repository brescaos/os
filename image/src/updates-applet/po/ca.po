#: metadata.json.in
msgid "BrescaOS;update;upgrade;version;"
msgstr "BrescaOS;actualització;actualitzar;versió;"

#: metadata.json.in
msgid "Tells when a new BrescaOS version is available"
msgstr "Avisa quan hi ha una nova versió de BrescaOS disponible"

#: package/contents/ui/main.qml
msgid "&Configure BrescaOS Updates…"
msgstr "&Configura Actualitzacions de BrescaOS…"

#: package/contents/ui/main.qml
msgid "BrescaOS %1 is available"
msgstr "BrescaOS %1 està disponible"

#: package/contents/ui/main.qml
msgid "BrescaOS %1 is downloaded"
msgstr "BrescaOS %1 està baixada"

#: package/contents/ui/main.qml
msgid "BrescaOS %1 is installed"
