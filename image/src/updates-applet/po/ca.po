#: brescaos-updates.notifyrc.in
msgid "A new BrescaOS version is available"
msgstr "Hi ha una nova versió de BrescaOS disponible"

#: brescaos-updates.notifyrc.in
msgid "A new BrescaOS version is downloaded"
msgstr "Hi ha una nova versió de BrescaOS baixada"

#: brescaos-updates.notifyrc.in
msgid "A new BrescaOS version is installed"
msgstr "Hi ha una nova versió de BrescaOS instal·lada"

#: brescaos-updates.notifyrc.in metadata.json.in package/contents/ui/main.qml
msgid "BrescaOS Updates"
msgstr "Actualitzacions de BrescaOS"

#: brescaos-updates.notifyrc.in
msgid "New BrescaOS versions"
msgstr "Noves versions de BrescaOS"

#: brescaos-updates.notifyrc.in
msgid ""
"When a check finds a newer version, and at every login until it's installed"
msgstr ""
"Quan una comprovació troba una versió més nova, i a cada inici de sessió "
"fins que s'instal·li"

#: brescaos-updates.notifyrc.in
msgid "When a new version is installed and starts after restarting"
msgstr "Quan s'instal·la una versió nova, que arrenca després de reiniciar"

#: brescaos-updates.notifyrc.in
msgid "When a version downloaded without installing it is ready to install"
msgstr "Quan una versió baixada sense instal·lar està a punt per instal·lar-se"

#. Search keywords: each one followed by a semicolon, no spaces
#: metadata.json.in
msgid "BrescaOS;update;upgrade;version;"
msgstr "BrescaOS;actualització;actualitzar;versió;"

#: metadata.json.in
msgid "Tells when a new BrescaOS version is available"
msgstr "Avisa quan hi ha una nova versió de BrescaOS disponible"

#: package/contents/ui/main.qml
