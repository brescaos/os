#!/usr/bin/env bash
# Fake podman for the tests, on $FAKE_STATE (a folder): logs each call in
# calls, one argument per line and an empty line after it; ps prints ps.json
# (or no container); exec exits with the status in exec-status (or 0); a
# command named in the file fail fails. Before that, it prints stderr's
# content to its standard error, and waits delay's seconds. events prints a
# line for each line appended to events, until it's killed.
set -euo pipefail

printf '%s\n' "$@" "" >>"$FAKE_STATE/calls"
[[ -f $FAKE_STATE/stderr ]] && cat "$FAKE_STATE/stderr" >&2
[[ -f $FAKE_STATE/delay ]] && sleep "$(cat "$FAKE_STATE/delay")"

if [[ -f $FAKE_STATE/fail ]] && grep -qx "$1" "$FAKE_STATE/fail"; then
    echo "fake podman: $1 failed" >&2
    exit 125
fi

case $1 in
    ps) cat "$FAKE_STATE/ps.json" 2>/dev/null || echo '[]' ;;
    create) echo 0123456789abcdef ;;
    events) exec tail -n 0 -F "$FAKE_STATE/events" 2>/dev/null ;;
    exec) exit "$(cat "$FAKE_STATE/exec-status" 2>/dev/null || echo 0)" ;;
    start | stop | rm | volume) ;;
    *)
        echo "fake podman: unexpected command: $*" >&2
        exit 2
        ;;
esac
