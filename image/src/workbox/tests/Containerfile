# check=skip=InvalidDefaultArgInFrom;error=true

# Tests of workbox in the image (scripts/test.sh, make test): bats, run in the
# BrescaOS image, so workbox, its settings and its translations are where
# image/Containerfile and build/system.sh put them. What it does has its own
# tests (make check-workbox); with the real Podman, it only runs in the
# development VM.

# The BrescaOS image to test. Required, no default: scripts/test.sh passes it.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=install_weak_deps=False --setopt=keepcache=True bats

COPY *.bats /usr/lib/bresca-tests/
COPY fakes/ /usr/lib/bresca-tests/fakes/

CMD ["bats", "--print-output-on-failure", "/usr/lib/bresca-tests"]
