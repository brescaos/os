#: cli/main.cpp
msgid ""
"Creates a workbox: a container that shares nothing with the host but the "
"folders given with -v.\n"
"\n"
"Example:\n"
"  workbox create c1 --name \"Client 01\" --color '#3584e4' -v ~/Clients/01:~/"
"project"
msgstr ""

