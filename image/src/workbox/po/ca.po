#: cli/main.cpp
msgid "unknown engine \"%1\" in workbox.conf: only podman"
msgstr "motor «%1» desconegut a workbox.conf: només podman"

#: cli/main.cpp
msgid "The workbox's id."
msgstr "L'id del workbox."

#: cli/main.cpp
msgid "workbox %1 takes one id (workbox %1 --help)"
msgstr "workbox %1 necessita un id (workbox %1 --help)"

#: cli/main.cpp
msgid ""
"Creates a workbox: a container that shares nothing with the host.\n"
"\n"
"Example:\n"
"  workbox create c1 --name \"Client 01\" --color '#3584e4'"
msgstr ""
"Crea un workbox: un contenidor que no comparteix res amb el sistema.\n"
"\n"
"Exemple:\n"
"  workbox create c1 --name \"Client 01\" --color '#3584e4'"

#: cli/main.cpp
msgid "The name it's shown with (default: its id)."
msgstr "El nom amb què es mostra (per defecte, el seu id)."

#: cli/main.cpp
msgctxt "value of --name"
msgid "name"
msgstr "nom"

#: cli/main.cpp
msgid ""
"Its color: #rgb, #rrggbb or r,g,b, each 0-255 (default: the palette's color "
"that looks the most different from the other workboxes')."
msgstr ""
"El seu color: #rgb, #rrggbb o r,g,b, cadascun de 0 a 255 (per defecte, el "
"color de la paleta que més es distingeix dels dels altres workboxes)."

#: cli/main.cpp
msgctxt "value of --color"
msgid "color"
msgstr "color"

#: cli/main.cpp
msgid "Created the workbox %1 (\"%2\")."
msgstr "S'ha creat el workbox %1 («%2»)."

#: cli/main.cpp
msgid ""
"Remove the workbox %1 (\"%2\") and its home? Everything in them will be "
"lost. [y/N] "
msgstr ""
"Vols eliminar el workbox %1 («%2») i la seva carpeta personal? Es perdrà tot "
"el que contenen. [s/N] "

#: cli/main.cpp
msgctxt "the answer to [y/N] that removes it"
msgid "y"
msgstr "s"

#: cli/main.cpp
msgid ""
"Removes a workbox and its home, stopping it first if it runs: everything in "
"them is lost. Asks before doing it, unless --yes.\n"
"\n"
"Example:\n"
"  workbox rm c1"
msgstr ""
"Elimina un workbox i la seva carpeta personal, i abans l'atura si està en "
"marxa: es perd tot el que contenen. Ho pregunta abans, tret que es faci "
"servir --yes.\n"
"\n"
"Exemple:\n"
"  workbox rm c1"

#: cli/main.cpp
msgid "Don't ask before removing it."
msgstr "No preguntar abans d'eliminar-lo."

#: cli/main.cpp
msgid "Nothing removed."
msgstr "No s'ha eliminat res."

#: cli/main.cpp
msgid "Removed the workbox %1."
msgstr "S'ha eliminat el workbox %1."

#: cli/main.cpp
msgid ""
"Lists the workboxes.\n"
"\n"
"Example:\n"
"  workbox list"
msgstr "Llista els workboxes.\n\nExemple:\n  workbox list"

#: cli/main.cpp
msgid "Only their ids, one per line."
msgstr "Només els seus ids, un per línia."

#: cli/main.cpp
msgid "workbox list takes no arguments (workbox list --help)"
msgstr "workbox list no admet arguments (workbox list --help)"

#: cli/main.cpp
msgid "No workboxes yet: workbox create <id> creates one."
msgstr "Encara no hi ha cap workbox: workbox create <id> en crea un."

#: cli/main.cpp
msgctxt "column of workbox list"
msgid "ID"
msgstr "ID"

#: cli/main.cpp
msgctxt "column of workbox list"
msgid "STATUS"
msgstr "ESTAT"

#: cli/main.cpp
msgctxt "status in workbox list"
msgid "running"
msgstr "en marxa"

#: cli/main.cpp
msgctxt "status in workbox list"
msgid "stopped"
msgstr "aturat"

#: cli/main.cpp
msgctxt "column of workbox list"
msgid "NAME"
msgstr "NOM"

#: cli/main.cpp
msgid ""
"Usage: workbox <command> [options]\n"
"\n"
"Runs containers, each a separate place to work, that share nothing with the "
"host.\n"
"\n"
"Commands:\n"
"  create  Create a workbox\n"
"  list    List the workboxes\n"
"  rm      Remove a workbox and its home\n"
"\n"
"\"workbox <command> --help\" shows a command's options."
msgstr ""
"Ús: workbox <ordre> [opcions]\n"
"\n"
"Executa contenidors, cadascun un lloc de treball a part, que no comparteixen "
"res amb el sistema.\n"
"\n"
"Ordres:\n"
"  create  Crea un workbox\n"
"  list    Llista els workboxes\n"
"  rm      Elimina un workbox i la seva carpeta personal\n"
"\n"
"«workbox <ordre> --help» mostra les opcions d'una ordre."

#: cli/main.cpp
msgid "unknown command \"%1\" (workbox --help)"
msgstr "ordre «%1» desconeguda (workbox --help)"

#: core/commands.cpp
msgid ""
"invalid id \"%1\": up to 32 lowercase letters (a-z), digits and hyphens, not "
"starting with a hyphen"
msgstr ""
"id «%1» no vàlid: fins a 32 lletres minúscules (a-z), dígits i guions, sense "
"començar per un guió"

#: core/commands.cpp
msgid "the name can't be empty"
msgstr "el nom no pot estar buit"

#: core/commands.cpp
msgid "invalid color \"%1\": use #rgb, #rrggbb or r,g,b (each 0-255)"
msgstr ""
"color «%1» no vàlid: fes servir #rgb, #rrggbb o r,g,b (cadascun de 0 a 255)"

#: core/commands.cpp
msgid "a workbox with the id \"%1\" already exists"
msgstr "ja hi ha un workbox amb l'id «%1»"

#: core/commands.cpp
msgid "there's no workbox with the id \"%1\""
msgstr "no hi ha cap workbox amb l'id «%1»"

#: core/settings.cpp
msgid "no %1 in %2 or %3"
msgstr "no hi ha %1 a %2 ni a %3"

#: engines/podman/podmanengine.cpp
msgid "couldn't run podman: %1"
msgstr "no s'ha pogut executar podman: %1"

#: engines/podman/podmanengine.cpp
msgid "podman %1 failed"
msgstr "ha fallat podman %1"
