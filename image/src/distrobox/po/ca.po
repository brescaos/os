#: krunner/runner.cpp
msgid ""
"Use only letters, digits, “_”, “.” and “-”, starting with a letter or a digit"
msgstr ""
"Fes servir només lletres, xifres, «_», «.» i «-», començant per una lletra o "
"una xifra"

#: krunner/runner.cpp
msgid "“%1” can't be a distrobox's name"
msgstr "«%1» no pot ser el nom d'un distrobox"
