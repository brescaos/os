msgid "Remove"
msgstr "Elimina"

#: applet/package/contents/ui/main.qml krunner/runner.cpp
msgid ""
"Remove the distrobox “%1”? Everything installed in it will be lost. Your "
"home folder is not affected."
msgstr ""
"Vols eliminar el distrobox «%1»? Es perdrà tot el que hi tinguis instal·lat. "
"La teva carpeta personal no es veu afectada."

#: applet/package/contents/ui/main.qml
msgid "Start"
msgstr "Inicia"

#: applet/package/contents/ui/main.qml
msgid "Stop"
msgstr "Atura"

#: krunner/com.brescaos.distrobox.desktop.in
msgid "Shows the progress of creating, stopping and removing distroboxes"
msgstr "Mostra el progrés en crear, aturar i eliminar distroboxes"

#: krunner/krunner_distrobox.json.in
msgid "Create, stop and remove your distroboxes"
msgstr "Crea, atura i elimina els teus distroboxes"

#: krunner/runner.cpp
msgid "Create distrobox “%1”"
msgstr "Crea el distrobox «%1»"

#: krunner/runner.cpp
msgid "Creates the distrobox :q:"
msgstr "Crea el distrobox :q:"

#: krunner/runner.cpp
msgid "Creating distrobox “%1”"
msgstr "S'està creant el distrobox «%1»"

#: krunner/runner.cpp
msgid "Distrobox “%1” already exists"
msgstr "El distrobox «%1» ja existeix"

#: krunner/runner.cpp
msgid "Remove distrobox “%1”"
msgstr "Elimina el distrobox «%1»"

#: krunner/runner.cpp
msgid "Removes the distrobox :q:"
msgstr "Elimina el distrobox :q:"

#: krunner/runner.cpp
msgid "Removing distrobox “%1”"
msgstr "S'està eliminant el distrobox «%1»"

#: krunner/runner.cpp
msgid "Stop distrobox “%1”"
