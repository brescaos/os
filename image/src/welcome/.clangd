# For clangd in the editor, without a build: the include folders of the
# headers the sources and tests use, as Fedora installs them. A new one goes
# here too.
# pp_file_not_found: logintest.moc and qmltest.moc only exist once moc runs,
# in a build.
CompileFlags:
  Add:
    - -std=c++20
    - -fPIC
    - -isystem/usr/include/qt6
    - -isystem/usr/include/qt6/QtCore
    - -isystem/usr/include/qt6/QtGui
    - -isystem/usr/include/qt6/QtWidgets
    - -isystem/usr/include/qt6/QtQml
    - -isystem/usr/include/qt6/QtQuick
    - -isystem/usr/include/qt6/QtQuickControls2
    - -isystem/usr/include/qt6/QtQuickTest
    - -isystem/usr/include/qt6/QtTest
    - -isystem/usr/include/KF6/KConfig
    - -isystem/usr/include/KF6/KConfigCore
    - -isystem/usr/include/KF6/KI18n
    - -DTRANSLATION_DOMAIN="bresca-welcome"
Diagnostics:
  Suppress: pp_file_not_found
