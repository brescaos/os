# shfmt reads its style from here (make check runs shfmt -d). The bresca CLI's
# scripts have no extension, so they are listed by path.
[{**.sh,**.bash,image/src/bresca-cli/bresca,image/src/bresca-cli/commands/*}]
indent_style = space
indent_size = 4
switch_case_indent = true
binary_next_line = true
