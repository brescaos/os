# shfmt reads its style from here (make check runs shfmt -d). Scripts without
# an extension (the bresca CLI's, the tests' fakes) are listed by path.
[{**.sh,**.bash,image/src/bresca-cli/bresca,image/src/bresca-cli/commands/**,image/src/bresca-cli/services/updates/**,image/src/bresca-cli/tests/fakes/**,image/src/distrobox/tests/fakes/**,**.bats}]
indent_style = space
indent_size = 4
switch_case_indent = true
binary_next_line = true
